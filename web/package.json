{
  "name": "palpitae-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "csp:verify": "node scripts/csp-verify.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc --noEmit -p functions",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "miniflare": "5.20260921.0-alpha",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.124.0"
  },
  "overrides": {
    "undici": "^7.29.1"
  },
  "engines": {
    "node": ">=24"
  }
}
