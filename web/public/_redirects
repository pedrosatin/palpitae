/api/* https://api.palpitae.com.br/:splat 200

# SPA client-side routes — rewrite to "/" (which serves index.html).
# We target "/" instead of "/index.html" because Cloudflare Pages strips
# .html extensions and /index suffixes, which triggers an infinite-loop
# detection that silently disables the rule.
# Static assets (/guias/*, sitemap.xml, og-image.png, …) are matched before
# these rules, so they always win.
/entrar / 200
/grupos/* / 200
/configuracoes / 200
/admin/metricas / 200
/admin/oportunidades / 200

# Unmatched paths: Cloudflare Pages automatically serves /404.html with a
# real 404 status when the file exists in the build output — no rule needed.
