/api/* https://api.palpitae.com.br/:splat 200

# SPA client-side routes — rewrite to "/" (which serves index.html).
# We target "/" instead of "/index.html" because Cloudflare Pages strips
# .html extensions and /index suffixes, which triggers an infinite-loop
# detection that silently disables the rule.
# Static assets (/guias/*, sitemap.xml, og-image.png, …) are matched before
# these rules, so they always win.
#
# Since the build pre-renders the landing page INTO index.html, these routes
# receive HTML that already contains the marketing page. A second HTML entry
# (an empty shell) was considered and rejected: Pages strips .html and /index
# from URLs, and the loop detection described above makes any rule pointing at a
# second HTML file a silent-failure risk in production, where a broken rule
# means every private route 404s. Instead index.html discards the pre-rendered
# markup, before the first paint, whenever the path is not "/" — see the two
# inline scripts in web/index.html. No redirect change was needed.
/entrar / 200
/grupos/* / 200
/configuracoes / 200
/admin/metricas / 200
/admin/oportunidades / 200

# Unmatched paths: Cloudflare Pages automatically serves /404.html with a
# real 404 status when the file exists in the build output — no rule needed.
