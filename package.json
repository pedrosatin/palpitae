{
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "oxlint api web scripts",
    "lint:fix": "oxlint --fix api web scripts",
    "format": "oxfmt api web scripts",
    "format:check": "oxfmt --check api web scripts",
    "test:api": "npm --prefix api test",
    "test:web": "npm --prefix web test",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test": "npm run test:api && npm run test:web && npm run test:scripts",
    "check:personal-data": "node scripts/personal-data-check.mjs",
    "typecheck": "npm --prefix api run typecheck && npm --prefix web run type-check",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0"
  }
}
