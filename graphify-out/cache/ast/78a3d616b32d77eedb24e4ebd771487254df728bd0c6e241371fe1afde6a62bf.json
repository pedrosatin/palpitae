   c.name  AS competition_name,\n         m.round AS round,\n         u.id    AS user_id,\n         u.email AS email,\n         g.id    AS group_id,\n         g.name  AS group_name\n       FROM matches m\n       JOIN competitions c   ON c.id = m.competition_id\n       JOIN groups g         ON g.competition_id = c.id AND g.deleted_at IS NULL\n       JOIN group_members gm ON gm.group_id = g.id\n       JOIN users u          ON u.id = gm.user_id\n       WHERE m.status = 'scheduled'\n         AND u.email_unsubscribed_at IS NULL\n         AND date(m.start_time, '-3 hours') = date('now', '-3 hours')\n         AND date(m.start_time, '-3 hours') = (\n           SELECT MIN(date(m2.start_time, '-3 hours'))\n           FROM matches m2\n           WHERE m2.competition_id = m.competition_id\n             AND m2.round = m.round\n         )\n         AND NOT EXISTS (\n           SELECT 1\n           FROM predictions p\n           JOIN matches pm ON pm.id = p.match_id\n           WHERE p.user_id  = u.id\n             AND p.group_id = g.id\n             AND pm.competition_id = c.id\n             AND pm.round = m.round\n         )`,\n    )\n    .all", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L123"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "prepare", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L123"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "info", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L160"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "logEvent", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L161"}, {"caller_nid": 