_team_id\n       WHERE m.status = 'scheduled'\n         AND (\n           SELECT MIN(date(m2.start_time))\n           FROM matches m2\n           WHERE m2.competition_id = m.competition_id\n             AND m2.round = m.round\n         ) = date('now', '+1 day')\n       ORDER BY m.start_time ASC`,\n    )\n    .all", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L114"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "prepare", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L114"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "get", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L140"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "push", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L142"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "values", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L152"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "sendEmail", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L161"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "logEvent", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L164"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "hashUserId", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpi