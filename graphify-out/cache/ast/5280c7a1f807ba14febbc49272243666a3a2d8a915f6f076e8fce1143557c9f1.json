eminder_sendroundreminders", "callee": "await db\n    .prepare(\n      `SELECT DISTINCT\n         c.name  AS competition_name,\n         m.round AS round,\n         u.email AS email\n       FROM matches m\n       JOIN competitions c   ON c.id = m.competition_id\n       JOIN groups g         ON g.competition_id = c.id\n       JOIN group_members gm ON gm.group_id = g.id\n       JOIN users u          ON u.id = gm.user_id\n       WHERE m.status = 'scheduled'\n         AND date(m.start_time) = date('now', '+1 day')\n         AND date(m.start_time) = (\n           SELECT MIN(date(m2.start_time))\n           FROM matches m2\n           WHERE m2.competition_id = m.competition_id\n             AND m2.round = m.round\n         )`,\n    )\n    .all", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L49"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "prepare", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L49"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "info", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L72"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "get", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L80"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "includes", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L82"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "push", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L82"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "set", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L84"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "await db\n    .prepare(\n      `SELECT\n         c.name   AS competition_name,\n         m.round  AS round,\n         ht.name  AS home_team,\n         awt.name AS away_team,\n         m.start_time\n       FROM matches m\n       JOIN competitions c ON c.id = m.competition_id\n       JOIN teams ht       ON ht.id = m.home_team_id\n       JOIN teams awt      ON awt.id = m.away_team_id\n       WHERE m.status = 'scheduled'\n         AND (\n           SELECT MIN(date(m2.start_time))\n           FROM matches m2\n           WHERE m2.competition_id = m.competition_id\n             AND m2.round = m.round\n         ) = date('now', '+1 day')\n       ORDER BY m.start_time ASC`,\n    )\n    .all", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L95"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "prepare", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L95"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "get", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L121"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "push", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L123"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "values", "is_member_call": true, "source_file": "/home/satin/Work/personal/