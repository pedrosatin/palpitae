        AND date(m.start_time, '-3 hours') = date('now', '-3 hours')\n         AND date(m.start_time, '-3 hours') = (\n           SELECT MIN(date(m2.start_time, '-3 hours'))\n           FROM matches m2\n           WHERE m2.competition_id = m.competition_id\n             AND m2.round = m.round\n         )\n         AND NOT EXISTS (\n           SELECT 1\n           FROM predictions p\n           JOIN matches pm ON pm.id = p.match_id\n           WHERE p.user_id  = u.id\n             AND p.group_id = g.id\n             AND pm.competition_id = c.id\n             AND pm.round = m.round\n         )`,\n    )\n    .all", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L98"}, {"caller_nid": "notifications_roundreminder_buildrecipientgroups", "callee": "prepare", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L98"}, {"caller_nid": "notifications_roundreminder_buildrecipientgroups", "callee": "get", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L142"}, {"caller_nid": "notifications_roundreminder_buildrecipientgroups", "callee": "get", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L144"}, {"caller_nid": "notifications_roundreminder_buildrecipientgroups", "callee": "some", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L147"}, {"caller_nid": "notifications_roundreminder_buildrecipientgroups", "callee": "push", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L148"}, {"caller_nid": "notifications_roundreminder_buildrecipientgroups", "callee": "set", "is_mem