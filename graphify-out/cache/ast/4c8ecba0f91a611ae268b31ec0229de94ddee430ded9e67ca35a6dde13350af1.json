JOIN matches pm ON pm.id = p.match_id\n           WHERE p.user_id  = u.id\n             AND p.group_id = g.id\n             AND pm.competition_id = c.id\n             AND pm.round = m.round\n         )`,\n    )\n    .bind(nowIso)\n    .all", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L88"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "bind", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L88"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "prepare", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L88"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "info", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L132"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "logEvent", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L133"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "get", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L143"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "some", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L145"}, {"caller_nid": "notifications_roundreminder_sendroundreminders", "callee": "push", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae/api/src/notifications/roundReminder.ts", "source_location": "L146"}, {"caller_nid": "noti