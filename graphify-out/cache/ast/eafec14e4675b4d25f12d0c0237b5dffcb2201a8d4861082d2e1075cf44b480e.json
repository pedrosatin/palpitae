nts > COALESCE(l.total_points, 0)\n            ),\n            1\n          ) AS user_position\n        FROM groups g\n        INNER JOIN group_members gm ON g.id = gm.group_id AND gm.user_id = ?\n        LEFT JOIN competitions c ON g.competition_id = c.id\n        LEFT JOIN leaderboard l ON g.id = l.group_id AND l.user_id = ?\n        WHERE g.deleted_at IS NULL\n        GROUP BY g.id\n        ORDER BY g.created_at DESC\n        `\n      )\n      .bind(userId, userId)\n      .all", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpitae-pr63/api/src/groups/router.ts", "source_location": "L47"}, {"caller_nid": "groups_router_handlegetgroups", "callee": "bind", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae-pr63/api/src/groups/router.ts", "source_location": "L47"}, {"caller_nid": "groups_router_handlegetgroups", "callee": "prepare", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae-pr63/api/src/groups/router.ts", "source_location": "L47"}, {"caller_nid": "groups_router_handlegetgroups", "callee": "find", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae-pr63/api/src/groups/router.ts", "source_location": "L87"}, {"caller_nid": "groups_router_handlegetgroups", "callee": "now", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae-pr63/api/src/groups/router.ts", "source_location": "L90"}, {"caller_nid": "groups_router_handlegetgroups", "callee": "map", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae-pr63/api/src/groups/router.ts", "source_location": "L92"}, {"caller_nid": "groups_router_handlegetgroups", "callee": "logRequestPerf", "is_member_call": false, "source_file": "/home/satin/Work/personal/palpitae-pr63/api/src/groups/router.ts", "source_location": "L107"}, {"caller_nid": "groups_router_handlegetgroups", "callee": "now", "is_member_call": true, "source_file": "/home/satin/Work/personal/palpitae-pr63/api/src/groups/route